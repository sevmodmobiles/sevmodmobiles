}

function wifiPresence(phone, ip, onWifi, reason, ssid, bssid) {
  var p = normalizePhone_(phone);
  if (!wifiProps_(WIFI_AUTO_KEY)[p]) return { status: 'ok', enabled: false };
  var emp = findEmployeeByPhone(p);
  if (!emp) return { status: 'error', message: 'Сотрудник не найден' };
  ip = cleanIp_(ip); ssid = cleanSsid_(ssid); bssid = cleanBssid_(bssid);
  var found = onWifi ? officeByWifi_(ssid, bssid, ip) : { office: '', by: '' };
  var office = found.office;
  var now = new Date(), st = wifiProps_(WIFI_STATE_KEY), cur = st[p] || {};
  var res = { status: 'ok', enabled: true, inOffice: !!office, office: office };
  // последняя проверка — для диагностики в «Профиле»
  var lastReport = { at: now.getTime(), ip: ip, onWifi: !!onWifi, office: office, by: found.by, ssid: ssid, bssid: bssid, reason: String(reason || '').slice(0, 20) };
  if (office) {
    var prevObj = cur.in ? cur.object : '', prevSeen = cur.lastSeen;
    if (prevObj && prevObj !== office) wifiLog_(emp.name, p, 'вышел из сети объекта', prevObj, ip, 'перешёл в сеть «' + office + '»', new Date(prevSeen || now));
    if (!cur.in || cur.object !== office) wifiLog_(emp.name, p, 'в сети объекта', office, ip, (ssid ? '«' + ssid + '» ' : '') + 'узнан по: ' + found.by + (reason ? ', ' + reason : ''));
    // последнее время в сети каждого объекта — чтобы при переезде закрыть прежнюю смену
    var seen = cur.seen || {};
    if (cur.object && cur.lastSeen && !seen[objKey_(cur.object)]) seen[objKey_(cur.object)] = cur.lastSeen;
    seen[objKey_(office)] = now.getTime();
    cur = { in: true, object: office, since: (cur.in && cur.object === office) ? cur.since : now.getTime(), lastSeen: now.getTime(), ip: ip, last: lastReport, failDay: cur.failDay, hiddenDay: cur.hiddenDay, unkKey: cur.unkKey, seen: seen };
    st[p] = cur; wifiSave_(WIFI_STATE_KEY, st);
    // авто-приход: первый за день, в разумное время
    var h = Number(Utilities.formatDate(now, 'Europe/Moscow', 'H'));
    var os = getOpenShift(p);
    // переезд: смена открыта на другом объекте — закрываем её временем
    // последнего присутствия в его сети (если он был сегодня в той сети)
    // Переезд: смена открыта на другом объекте — закрываем её последним временем
    // в его сети (если оно известно и позже начала смены), иначе — сейчас.
    if (os.open && objKey_(os.objectName) !== objKey_(office)) {
      var lastThere = seen[objKey_(os.objectName)] || wifiLastSeenFromLog_(p, os.objectName), since = os.since ? Number(os.since) || new Date(os.since).getTime() : 0;
      var at = lastThere && (!since || lastThere > since) && lastThere < now.getTime() ? new Date(lastThere) : now;
      if (wifiCloseShiftAt_(p, emp.name, os.objectName, at, 'авто: появился на «' + office + '» (по Wi-Fi)' + (at === now ? ', время в прежней сети неизвестно' : ''))) {
        wifiLog_(emp.name, p, 'авто-уход', os.objectName, ip, 'переход на «' + office + '», уход в ' + clockStr_(at));
        os = getOpenShift(p);
      }
    }
    // повторный приход в тот же день — только если после ухода человек выходил из сети
    // (вернулся с обеда); вручную отметил уход, оставаясь в сети, — приход не ставим
    var lastDep = lastDepartureToday_(p, office);
    var canIn = !hadArrivalToday_(p, office) || (lastDep && cur.since && cur.since > lastDep);
    if (!os.open && canIn) {
      // время прихода — первое появление в сети объекта (если приход ставится позже, например после закрытия прежней смены)
      var inAt = cur.since && cur.since < now.getTime() && toIsoDate_(new Date(cur.since)) === toIsoDate_(now) ? cur.since : now.getTime();
      var r = logEvent(emp.name, p, office, 'Приход', null, inAt, 'wifi' + p + toIsoDate_(now).replace(/-/g, '') + '_' + objKey_(office).replace(/[^a-zа-я0-9]/gi, '').slice(0, 20) + '_' + Math.floor(inAt / 60000), ip, ssid, bssid);
      var okIn = r && r.status === 'ok';
      // отказ — в журнал не чаще раза в день (телефон проверяет каждые ~15 минут)
      if (okIn || cur.failDay !== toIsoDate_(now)) {
        wifiLog_(emp.name, p, okIn ? 'авто-приход' : 'авто-приход не принят', office, ip, okIn ? '' : (r && r.message || ''));
        if (!okIn) { cur.failDay = toIsoDate_(now); st[p] = cur; wifiSave_(WIFI_STATE_KEY, st); }
      }
      res.checkedIn = !!(r && r.status === 'ok');
      if (res.checkedIn) sendPush_([p], 'Приход отмечен автоматически', office + ', ' + clockStr_(new Date(inAt)) + ' — по Wi-Fi объекта', { screen: 'scan', tag: 'shift' });
    }
  } else if (cur.in) {
    // время — последнее присутствие в сети; когда заметили выход — в примечании
    wifiLog_(emp.name, p, 'вышел из сети объекта', cur.object, ip, (onWifi ? 'другая сеть Wi-Fi' : 'Wi-Fi отключён') + ', замечено в ' + clockStr_(now), new Date(cur.lastSeen || now));
    cur.in = false; cur.last = lastReport; st[p] = cur; wifiSave_(WIFI_STATE_KEY, st);
  } else {
    cur.last = lastReport;
    // В Wi-Fi, но имя сети и роутер не видны: в фоне Android отдаёт их только
    // при геолокации «Разрешить всегда». По IP офис не узнан — подсказываем раз в день.
    var day = toIsoDate_(now);
    // Wi-Fi с именем, но ни к одному объекту не подходит — раз в день на сеть пишем в журнал
    var nk = day + '|' + (ssid || '') + '|' + (bssid || ip || '');
    if (onWifi && (ssid || bssid) && cur.unkKey !== nk) {
      cur.unkKey = nk;
      wifiLog_(emp.name, p, 'Wi-Fi не узнан', '', ip, (ssid ? '«' + ssid + '»' : 'без имени') + (bssid ? ' (' + bssid + ')' : '') + (reason ? ', ' + reason : ''));
    }
    if (onWifi && !ssid && !bssid && cur.hiddenDay !== day) {
      cur.hiddenDay = day;
      wifiLog_(emp.name, p, 'сеть не видна', '', ip, 'телефон в Wi-Fi, но имя сети скрыто: нужна геолокация «Разрешить всегда»' + (reason ? ', ' + reason : ''));
      sendPush_([p], 'Автоотметка не видит Wi-Fi', 'Разрешите SEVMOD доступ к геолокации «Всегда» — без этого телефон не сообщает имя сети. Профиль → Автоотметка.', { screen: 'profile', tag: 'wifi' });
    }
    st[p] = cur; wifiSave_(WIFI_STATE_KEY, st);
  }
  return res;
}

// Последнее время в сети объекта по журналу: строка «вышел из сети объекта»
// пишется временем последнего присутствия. Смотрим только последние 300 строк.
function wifiLastSeenFromLog_(phone, object) {
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Wi-Fi присутствие');
  if (!sh || sh.getLastRow() < 2) return 0;
  var n = Math.min(sh.getLastRow() - 1, 300), v = sh.getRange(sh.getLastRow() - n + 1, 1, n, 5).getValues(), k = objKey_(object);
  for (var i = v.length - 1; i >= 0; i--) {
    if (normalizePhone_(v[i][2]) !== phone || objKey_(v[i][4]) !== k) continue;
    if (String(v[i][3]) === 'вышел из сети объекта' && v[i][0] instanceof Date) return v[i][0].getTime();
    if (String(v[i][3]) === 'в сети объекта') return 0; // после входа выхода не было
  }
  return 0;
}
// Время последнего ухода сегодня с объекта (0 — не было).
function lastDepartureToday_(phone, object) {
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Учет');
  if (!sh || sh.getLastRow() < 2) return 0;
  var n = Math.min(sh.getLastRow() - 1, 400), today = toIsoDate_(new Date()), k = objKey_(object);
  var rows = sh.getRange(sh.getLastRow() - n + 1, 1, n, 5).getValues(), best = 0;
  rows.forEach(function (r) {
    if (!(r[0] instanceof Date) || toIsoDate_(r[0]) !== today || normalizePhone_(r[2]) !== phone || r[4] !== 'Уход' || objKey_(r[3]) !== k) return;
    if (r[0].getTime() > best) best = r[0].getTime();
  });
  return best;
}
// Был ли сегодня приход (на объекте object, если указан).
function hadArrivalToday_(phone, object) {
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Учет');
  if (!sh || sh.getLastRow() < 2) return false;
  var n = Math.min(sh.getLastRow() - 1, 400), today = toIsoDate_(new Date());
  var rows = sh.getRange(sh.getLastRow() - n + 1, 1, n, 5).getValues();
  for (var i = rows.length - 1; i >= 0; i--) {
    var ts = rows[i][0];
    if (!(ts instanceof Date)) continue;
    if (toIsoDate_(ts) !== today) { if (ts < startOfDay_(new Date())) break; else continue; }
    if (normalizePhone_(rows[i][2]) === phone && rows[i][4] === 'Приход' && (!object || objKey_(rows[i][3]) === objKey_(object))) return true;
  }
  return false;
}

// Закрыть открытую смену уходом в момент at (с пометкой).
function wifiCloseShiftAt_(phone, name, objectName, at, note) {
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(15000)) return false;
  try {
    var map = getOpenShiftsMap_();
    if (!map[phone]) return false;
    var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Учет');
    sheet.appendRow([at, name, phone, objectName, 'Уход', '', '', '', note, new Date()]);
    var row = sheet.getLastRow();
    sheet.getRange(row, 3).setNumberFormat('@').setValue(String(phone));
    sheet.getRange(row, 10).setNumberFormat('dd.MM.yyyy HH:mm:ss');
    delete map[phone]; saveOpenShiftsMap_(map);
    return true;
  } finally {
    lock.releaseLock();
  }
}

// Раз в час: в 22:00 (и позже) — закрыть открытые смены тех, у кого включена
// автоотметка, временем последнего присутствия в сети офиса.
var WIFI_LEAVE_MIN = 45;
function wifiCloseDay_() {
  var auto = wifiProps_(WIFI_AUTO_KEY), phones = Object.keys(auto);
  if (!phones.length) return 0;
  var now = new Date(), h = Number(Utilities.formatDate(now, 'Europe/Moscow', 'H')), today = startOfDay_(now);
  var st = wifiProps_(WIFI_STATE_KEY), closed = 0;
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) return 0;
  try {
    var map = getOpenShiftsMap_(), sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Учет');
    phones.forEach(function (p) {
      var e = map[p], s = st[p];
      if (!e || !s || !s.lastSeen) return;
      var since = e.since || openShiftSinceFromLog_(p);
      if (!since) return;
      var sinceDay = startOfDay_(new Date(since));
      // По последнему сообщению телефона человек в сети этого объекта — не закрываем
      // (телефон ночью может молчать часами — это не уход).
      if (s.in && objKey_(s.object) === objKey_(e.objectName)) return;
      // последнее время именно в сети объекта этой смены (если известно)
      var lastObj = (s.seen && s.seen[objKey_(e.objectName)]) || wifiLastSeenFromLog_(p, e.objectName);
      if (!lastObj && objKey_(s.object) === objKey_(e.objectName)) lastObj = s.lastSeen;
      if (!lastObj) return;
      var last = new Date(lastObj);
      if (last <= new Date(since) || now.getTime() - last.getTime() > 36 * 3600000) return; // после прихода в сети не был
      // вышел ненадолго (обед, перекур) — ждём 45 минут, вдруг вернётся
      if (now.getTime() - last.getTime() < WIFI_LEAVE_MIN * 60000) return;
      var emp = findEmployeeByPhone(p);
      sheet.appendRow([last, emp ? emp.name : '', p, e.objectName, 'Уход', '', '', '', 'авто: последний раз в Wi-Fi объекта', now]);
      var row = sheet.getLastRow();
      sheet.getRange(row, 3).setNumberFormat('@').setValue(String(p));
      sheet.getRange(row, 10).setNumberFormat('dd.MM.yyyy HH:mm:ss');
      delete map[p]; closed++;
      wifiLog_(emp ? emp.name : '', p, 'авто-уход', e.objectName, s.ip || '', 'смена закрыта в ' + clockStr_(last));
      sendPush_([p], 'Смена закрыта автоматически', e.objectName + ': уход в ' + clockStr_(last) + ' — последний раз в Wi-Fi объекта. Если ушли в другое время — сообщите руководителю.', { screen: 'stats', tag: 'shift' });
    });
    if (closed) saveOpenShiftsMap_(map);
  } finally {
    lock.releaseLock();
  }
  return closed;
}


// ===================== РОЛИ (v96) =====================
// «Сотрудники», колонка J «Роли»: прораб, кладовщик, снабжение (через запятую).
// Администратор (галочка G) может работать в любой роли.
var EMP_ROLES_COL = 10;
var ROLE_KEYS = { 'прораб': 'foreman', 'кладовщик': 'storekeeper', 'снабжение': 'supply', 'снабженец': 'supply' };
function empRowRoles_(row) {
  var adm = row[6] === true || String(row[6]).trim().toUpperCase() === 'TRUE';
  if (adm) return ['admin', 'storekeeper', 'foreman', 'supply'];
  var c = empCol_(), out = [];
  Object.keys(c.roleCols).forEach(function (role) {
    var v = row[c.roleCols[role] - 1];
    if (v === true || String(v).trim().toUpperCase() === 'TRUE') out.push(role);
  });
  if (c.ROLES) String(row[c.ROLES - 1] || '').toLowerCase().split(/[,;\s]+/).forEach(function (x) {
    var k = ROLE_KEYS[x.trim()]; if (k && out.indexOf(k) < 0) out.push(k);
  });
