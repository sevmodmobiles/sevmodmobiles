}

// Производственный календарь РФ: нерабочие праздничные дни (с переносами)
// и рабочие субботы. 2026 — по постановлению Правительства (247 рабочих дней).
// Для лет без списка — фиксированные праздники с переносом с выходного на понедельник.
var RU_HOLIDAYS = {
  2026: ['2026-01-01', '2026-01-02', '2026-01-05', '2026-01-06', '2026-01-07', '2026-01-08', '2026-01-09',
    '2026-02-23', '2026-03-09', '2026-05-01', '2026-05-11', '2026-06-12', '2026-11-04', '2026-12-31']
};
var RU_WORK_SATURDAYS = { 2026: [] };
var ruCalCache_ = {};
function ruCalendar_(year) {
  if (ruCalCache_[year]) return ruCalCache_[year];
  var off = {}, on = {};
  if (RU_HOLIDAYS[year]) {
    RU_HOLIDAYS[year].forEach(function (d) { off[d] = true; });
    (RU_WORK_SATURDAYS[year] || []).forEach(function (d) { on[d] = true; });
  } else {
    var fixed = ['01-01', '01-02', '01-03', '01-04', '01-05', '01-06', '01-07', '01-08', '02-23', '03-08', '05-01', '05-09', '06-12', '11-04'];
    fixed.forEach(function (md) {
      var d = parseIsoDate_(year + '-' + md);
      off[toIsoDate_(d)] = true;
      if (md.indexOf('01-') === 0) return;
      var w = d.getDay();
      if (w === 6 || w === 0) { d.setDate(d.getDate() + (w === 6 ? 2 : 1)); off[toIsoDate_(d)] = true; }
    });
  }
  return (ruCalCache_[year] = { off: off, on: on });
}
function isRuWorkday_(d) {
  var iso = toIsoDate_(d), cal = ruCalendar_(d.getFullYear());
  if (cal.on[iso]) return true;
  var w = d.getDay();
  return w !== 0 && w !== 6 && !cal.off[iso];
}

// Управленческий отчёт по окладникам за месяц month = 'yyyy-MM'.
function adminSalaryReport(phone, month) {
  var auth = adminAuth_(phone);
  if (!auth.ok) return { status: 'error', message: auth.error };
  var tz = Session.getScriptTimeZone();
  var m = /^(\d{4})-(\d{2})$/.exec(String(month || ''));
  var now = new Date();
  var year = m ? Number(m[1]) : now.getFullYear(), mon = m ? Number(m[2]) - 1 : now.getMonth();
  var start = new Date(year, mon, 1), end = new Date(year, mon + 1, 0);
  var today = parseIsoDate_(toIsoDate_(now));
  var yesterday = new Date(today.getTime()); yesterday.setDate(yesterday.getDate() - 1);
  var upTo = end < today ? end : today;          // учитываем дни по сегодня включительно
  var missUpTo = end < yesterday ? end : yesterday; // «без отметки» — только прошедшие дни

  function eachDay_(a, b, fn) { for (var d = new Date(a.getTime()); d <= b; d.setDate(d.getDate() + 1)) fn(new Date(d.getTime())); }
  var monthWorkdays = 0, passedWorkdays = 0;
  eachDay_(start, end, function (d) { if (isRuWorkday_(d)) { monthWorkdays++; if (d <= upTo) passedWorkdays++; } });

  var empSheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Сотрудники');
  if (!empSheet || empSheet.getLastRow() < 2) return { status: 'ok', month: year + '-' + ('0' + (mon + 1)).slice(-2), people: [] };
  ensurePayColumns_(empSheet);
  var emps = empSheet.getRange(2, 1, empSheet.getLastRow() - 1, empWidth_(empSheet)).getValues()
    .filter(function (r) { return r[0] && payTypeOf_(r[EMP_COL.PAY_TYPE - 1]) === PAY_SALARY; })
    .map(function (r) {
      return { name: String(r[0]), phone: normalizePhone_(r[1]), reg: r[2] instanceof Date ? parseIsoDate_(toIsoDate_(r[2])) : null,
        salary: Number(r[EMP_COL.SALARY - 1]) || 0 };
    });
  var byPhone = {};
  emps.forEach(function (e) {
    byPhone[e.phone] = e;
    e.days = {}; e.lateMinutes = 0; e.hoursMs = 0; e.weekendDays = 0;
    e.leave = {}; e.sick = {}; e.partialHours = 0; e.partialCount = 0;
  });

  // Отметки за месяц.
  var log = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Учет');
  if (log && log.getLastRow() >= 2 && emps.length) {
    var rows = log.getRange(2, 1, log.getLastRow() - 1, 6).getValues();
    var perDay = {};
    rows.forEach(function (r) {
      var ts = r[0]; if (!(ts instanceof Date) || ts < start || ts > new Date(year, mon + 1, 1)) return;
      var e = byPhone[normalizePhone_(r[2])]; if (!e) return;
      var iso = toIsoDate_(ts), key = e.phone + '|' + iso;
      var pd = perDay[key] || (perDay[key] = { e: e, iso: iso, arr: null, dep: null, late: null });
      if (r[4] === 'Приход') { if (!pd.arr || ts < pd.arr) { pd.arr = ts; pd.late = computeLate_(ts, r[3], r[2]); } }
      else if (r[4] === 'Уход') { if (!pd.dep || ts > pd.dep) pd.dep = ts; }
    });
    Object.keys(perDay).forEach(function (k) {
      var pd = perDay[k], e = pd.e;
      e.days[pd.iso] = true;
      if (!isRuWorkday_(parseIsoDate_(pd.iso))) e.weekendDays++;
      if (pd.late > 0) e.lateMinutes += pd.late;
      if (pd.arr && pd.dep && pd.dep > pd.arr && pd.dep - pd.arr < 20 * 3600000) e.hoursMs += pd.dep - pd.arr;
    });
  }

  // Согласованные отсутствия.
  var abs = getExistingAbsenceSheet_();
  if (abs && abs.getLastRow() >= 2 && emps.length) {
    abs.getRange(2, 1, abs.getLastRow() - 1, ABSENCE_HEADERS.length).getValues().forEach(function (r) {
      if (absStatusOf_(r[ABS_COL.STATUS - 1]) !== ABS_STATUS.APPROVED) return;
      var e = byPhone[normalizePhone_(r[ABS_COL.PHONE - 1])]; if (!e) return;
      var f = r[ABS_COL.FROM - 1], t = r[ABS_COL.TO - 1];
      if (!(f instanceof Date)) return;
      f = parseIsoDate_(toIsoDate_(f)); t = t instanceof Date ? parseIsoDate_(toIsoDate_(t)) : f;
      var type = r[ABS_COL.TYPE - 1];
      if (type === ABSENCE_KINDS.late || type === ABSENCE_KINDS.early) {
        if (f >= start && f <= upTo) { e.partialHours += Number(r[ABS_COL.HOURS - 1]) || 0; e.partialCount++; }
        return;
      }
      var a = f < start ? start : f, b = t > upTo ? upTo : t;
      if (a > b) return;
      eachDay_(a, b, function (d) {
        if (!isRuWorkday_(d)) return;
        var iso = toIsoDate_(d);
        if (type === ABSENCE_KINDS.sick) e.sick[iso] = true; else e.leave[iso] = true;
      });
    });
  }

  function r0_(x) { return Math.round(x); }
  var totals = { salary: 0, leave: 0, sick: 0, noMark: 0, partial: 0, late: 0, total: 0 };
  var people = emps.map(function (e) {
    var dayCost = monthWorkdays ? e.salary / monthWorkdays : 0;
    var worked = 0, leaveDays = 0, sickDays = 0, noMarkDates = [];
    eachDay_(start, upTo, function (d) {
      if (!isRuWorkday_(d)) return;
      var iso = toIsoDate_(d);
      if (e.days[iso]) { worked++; return; }
      if (e.sick[iso]) { sickDays++; return; }
      if (e.leave[iso]) { leaveDays++; return; }
      if (d > missUpTo) return;
      if (e.reg && d < e.reg) return;
      noMarkDates.push(iso);
    });
    var a = {
      leave: r0_(leaveDays * dayCost), sick: r0_(sickDays * dayCost), noMark: r0_(noMarkDates.length * dayCost),
      partial: r0_(e.partialHours / WORKDAY_HOURS * dayCost), late: r0_(e.lateMinutes / 60 / WORKDAY_HOURS * dayCost)
    };
    var total = a.leave + a.sick + a.noMark + a.partial + a.late;
    totals.salary += e.salary; totals.leave += a.leave; totals.sick += a.sick; totals.noMark += a.noMark;
    totals.partial += a.partial; totals.late += a.late; totals.total += total;
    return {
      name: e.name, phone: e.phone, salary: e.salary, dayCost: r0_(dayCost),
      workedDays: worked, weekendDays: e.weekendDays, hours: Math.round(e.hoursMs / 360000) / 10,
      leaveDays: leaveDays, sickDays: sickDays, noMarkDays: noMarkDates.length, noMarkDates: noMarkDates,
      partialHours: round2_(e.partialHours), partialCount: e.partialCount, lateMinutes: e.lateMinutes,
      amounts: a, total: total, totalPct: e.salary ? Math.round(total / e.salary * 1000) / 10 : 0
    };
  }).sort(function (x, y) { return y.total - x.total; });
  return {
    status: 'ok', month: year + '-' + ('0' + (mon + 1)).slice(-2),
    monthWorkdays: monthWorkdays, passedWorkdays: passedWorkdays,
    upTo: toIsoDate_(upTo), isCurrent: upTo < end, isFuture: start > today,
    calendarExact: !!RU_HOLIDAYS[year],
    people: people, totals: totals
  };
}

// Время прихода открытой смены, если его нет в карте (смена открыта до v68):
// последний «Приход» этого телефона в журнале «Учет». Найденное время
// сохраняется в карту, чтобы больше не искать.
// Раз в час: начало открытых смен — по последнему «Приходу» в журнале «Учет»
// (если время прихода поправили в таблице, приложение покажет исправленное).
function reconcileOpenShiftSince_() {
  var map = getOpenShiftsMap_(), phones = Object.keys(map);
  if (!phones.length) return;
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Учет');
  if (!sheet || sheet.getLastRow() < 2) return;
  var n = Math.min(sheet.getLastRow() - 1, 1500), data = sheet.getRange(sheet.getLastRow() - n + 1, 1, n, 5).getValues(), seen = {}, changed = false;
  for (var i = data.length - 1; i >= 0; i--) {
    var p = normalizePhone_(data[i][2]); if (!map[p] || seen[p]) continue;
    seen[p] = true;
    if (data[i][4] === 'Приход' && data[i][0] instanceof Date && Math.abs((Number(map[p].since) || 0) - data[i][0].getTime()) > 60000) {
      map[p].since = data[i][0].getTime(); changed = true;
    }
  }
  if (changed) saveOpenShiftsMap_(map);
}
function openShiftSinceFromLog_(phone) {
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Учет');
  if (!sheet || sheet.getLastRow() < 2) return null;
  var p = normalizePhone_(phone);
  var data = sheet.getRange(2, 1, sheet.getLastRow() - 1, 5).getValues();
  for (var i = data.length - 1; i >= 0; i--) {
    if (normalizePhone_(data[i][2]) !== p) continue;
    if (data[i][4] === 'Уход') return null;          // последняя отметка — уход: открытой смены по журналу нет
    if (data[i][4] === 'Приход' && data[i][0] instanceof Date) {
      var since = data[i][0].getTime();
      try {
        var map = getOpenShiftsMap_();
        if (map[p] && !map[p].since) { map[p].since = since; saveOpenShiftsMap_(map); }
      } catch (e) {}
      return since;
    }
  }
  return null;
}

// ===================== НЕЗАКРЫТЫЕ СМЕНЫ (v71) =====================
var MISSED_PROP_KEY = 'missedCheckouts_v1';
var AUTO_CLOSE_NOTE = 'автозакрытие (уход не отмечен)';
var DEFAULT_DAY_END = '18:00';
function clockStr_(d) { return Utilities.formatDate(d, 'Europe/Moscow', 'HH:mm'); }
function startOfDay_(d) { return new Date(d.getFullYear(), d.getMonth(), d.getDate()); }
function atTime_(day, hhmm) { var p = String(hhmm).split(':'); return new Date(day.getFullYear(), day.getMonth(), day.getDate(), Number(p[0]), Number(p[1])); }
function loadMissed_() { try { return JSON.parse(PropertiesService.getScriptProperties().getProperty(MISSED_PROP_KEY) || '{}') || {}; } catch (e) { return {}; } }
function saveMissed_(m) { PropertiesService.getScriptProperties().setProperty(MISSED_PROP_KEY, JSON.stringify(m)); }

// Когда должна была закончиться смена, начатая в since на объекте objectName:
// конец ближайшей по началу смены графика объекта (через полночь — на
// следующий день), иначе 18:00 того же дня, а для прихода после 18:00 — +8 ч.
function expectedShiftEnd_(objectName, since) {
  var arr = new Date(since);
  var shifts = (getObjectShifts()[objectName] || []);
  var nearest = findNearestShift(arr, shifts);
  if (nearest) {
    var sh = shifts.filter(function (x) { return x.start === nearest.shiftStart; })[0];
    if (sh && sh.end) {
      var end = atTime_(arr, sh.end);
      if (timeStrToMinutes(sh.end) <= timeStrToMinutes(sh.start) || end <= arr) end.setDate(end.getDate() + 1);
      if (end > arr) return end;
    }
  }
  var e = atTime_(arr, DEFAULT_DAY_END);
  return e > arr ? e : new Date(arr.getTime() + 8 * 3600000);
}

// Незакрытая смена сотрудника для утреннего вопроса: ещё открытая с
// прошлого дня или закрытая автоматически, но не подтверждённая.
function missedCheckoutFor_(phone, openShift) {
  var p = normalizePhone_(phone);
  var today = startOfDay_(new Date());
  if (openShift && openShift.open) {
    var since = openShift.since || openShiftSinceFromLog_(p);
    if (since && new Date(since) < today) {
      var end = expectedShiftEnd_(openShift.objectName, since);
      if (end < new Date()) {
        return { kind: 'open', date: toIsoDate_(new Date(since)), objectName: openShift.objectName,
          arrival: clockStr_(new Date(since)), suggest: clockStr_(end) };
      }
    }
    return null;
  }
  var m = loadMissed_()[p];
  return m ? { kind: 'auto', date: m.date, objectName: m.objectName, arrival: m.arrival, suggest: m.autoTime } : null;
}

// Раз в час: закрывает смены, открытые в прошлые дни, если ожидаемый конец
// смены прошёл больше 2 часов назад.
function autoCloseStaleShifts_() {
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) return 0;
  try {
    var map = getOpenShiftsMap_(), missed = loadMissed_(), now = new Date(), today = startOfDay_(now), closed = 0, notify = [];
    var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Учет');
    if (!sheet) return 0;
    Object.keys(map).forEach(function (p) {
      var e = map[p];
      var since = e.since || openShiftSinceFromLog_(p);
      if (!since || new Date(since) >= today) return;
      var end = expectedShiftEnd_(e.objectName, since);
      if (now.getTime() - end.getTime() < 2 * 3600000) return;
      var emp = findEmployeeByPhone(p);
      sheet.appendRow([end, emp ? emp.name : '', p, e.objectName, 'Уход', '', '', '', AUTO_CLOSE_NOTE, now]);
      var row = sheet.getLastRow();
      sheet.getRange(row, 3).setNumberFormat('@').setValue(String(p));
      sheet.getRange(row, 10).setNumberFormat('dd.MM.yyyy HH:mm:ss');
      missed[p] = { row: row, date: toIsoDate_(new Date(since)), objectName: e.objectName, arrival: clockStr_(new Date(since)),
        since: since, autoTime: clockStr_(end), autoDate: toIsoDate_(end) };
      notify.push([p, e.objectName, Utilities.formatDate(new Date(since), 'Europe/Moscow', 'dd.MM'), clockStr_(end)]);
      delete map[p];
      closed++;
    });
    if (closed) { saveOpenShiftsMap_(map); saveMissed_(missed); }
  } finally {
    lock.releaseLock();
  }
  notify.forEach(function (n) {
    sendPush_([n[0]], 'Смена закрыта автоматически', 'Вы не отметили уход ' + n[2] + ' («' + n[1] + '»), поставили ' + n[3] +
      '. Если ушли в другое время — откройте приложение и укажите.', { screen: 'scan', tag: 'shift' });
  });
  return closed;
}

// Сотрудник назвал время ухода (HH:mm) для незакрытой смены.
function closeMissedShift(phone, time) {
  var p = normalizePhone_(phone);
  if (!/^([01]\d|2[0-3]):[0-5]\d$/.test(String(time || ''))) return { status: 'error', message: 'Укажите время в формате ЧЧ:ММ' };
  var emp = findEmployeeByPhone(p);
  if (!emp) return { status: 'error', message: 'Сотрудник не найден' };
  var lock = LockService.getScriptLock();
  lock.waitLock(15000);
  try {
    var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Учет');
    var map = getOpenShiftsMap_(), missed = loadMissed_(), today = startOfDay_(new Date());
    var entry = map[p];
    if (entry) {
      var since = entry.since || openShiftSinceFromLog_(p);
      if (!since || new Date(since) >= today) return { status: 'error', message: 'Сегодняшняя смена ещё идёт — отметьте уход, отсканировав QR-код' };
      var t = atTime_(new Date(since), time);
      if (t <= new Date(since)) t.setDate(t.getDate() + 1); // смена через полночь
      if (t > new Date() || t - since > 20 * 3600000) return { status: 'error', message: 'Проверьте время: смена получается длиннее 20 часов' };
      sheet.appendRow([t, emp.name, p, entry.objectName, 'Уход', '', '', '', 'уход со слов сотрудника (не отметил)', new Date()]);
      var row = sheet.getLastRow();
      sheet.getRange(row, 3).setNumberFormat('@').setValue(String(p));
      sheet.getRange(row, 10).setNumberFormat('dd.MM.yyyy HH:mm:ss');
      delete map[p]; saveOpenShiftsMap_(map);
      return { status: 'ok', closed: toIsoDate_(t), time: time };
    }
    var m = missed[p];
    if (!m) return { status: 'error', message: 'Незакрытых смен нет' };
    var r = sheet.getRange(m.row, 1, 1, 9).getValues()[0];
    if (normalizePhone_(r[2]) !== p || r[4] !== 'Уход' || String(r[8]).indexOf('автозакрытие') !== 0) {
      delete missed[p]; saveMissed_(missed);
      return { status: 'error', message: 'Запись автозакрытия не найдена — сообщите руководителю время ухода' };
    }
    var t2 = atTime_(new Date(m.since), time);
    if (t2 <= new Date(m.since)) t2.setDate(t2.getDate() + 1);
    if (t2 - m.since > 20 * 3600000) return { status: 'error', message: 'Проверьте время: смена получается длиннее 20 часов' };
    sheet.getRange(m.row, 1).setValue(t2);
    sheet.getRange(m.row, 9).setValue('уход со слов сотрудника (автозакрытие исправлено)');
    delete missed[p]; saveMissed_(missed);
    return { status: 'ok', closed: toIsoDate_(t2), time: time };
  } finally {
    lock.releaseLock();
  }
}

// ===================== Wi-Fi ОФИСА (v72) =====================
function cleanIp_(ip) {
  var s = String(ip || '').trim();
  return /^(\d{1,3}\.){3}\d{1,3}$/.test(s) || /^[0-9a-f:]{3,45}$/i.test(s) ? s.toLowerCase() : '';
}
function splitIps_(v) { return String(v || '').split(/[\s,;]+/).map(cleanIp_).filter(String); }
function objectWifiIps_(objectName) {
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Объекты');
  if (!sheet || sheet.getLastRow() < 2 || sheet.getLastColumn() < OBJ_COL.WIFI) return [];
  var data = sheet.getRange(2, 1, sheet.getLastRow() - 1, OBJ_COL.WIFI).getValues();
  for (var i = 0; i < data.length; i++) {
    if (String(data[i][0]).trim() === objectName) return splitIps_(data[i][OBJ_COL.WIFI - 1]);
  }
  return [];
}
// mode: 'add' — добавить ip; 'remove' — убрать ip; 'clear' — очистить.
function adminSetObjectWifi(adminPhone, objectName, ip, mode) {
  var auth = adminAuth_(adminPhone);
  if (!auth.ok) return { status: 'error', message: auth.error };
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Объекты');
  if (!sheet || sheet.getLastRow() < 2) return { status: 'error', message: 'Объект не найден' };
  if (String(sheet.getRange(1, OBJ_COL.WIFI).getValue()).trim() !== 'Wi-Fi объекта (IP)') sheet.getRange(1, OBJ_COL.WIFI).setValue('Wi-Fi объекта (IP)');
  var name = String(objectName || '').trim(), addr = cleanIp_(ip);
  if (mode !== 'clear' && !addr) return { status: 'error', message: 'Не удалось определить IP сети' };
  var names = sheet.getRange(2, 1, sheet.getLastRow() - 1, 1).getValues();
  for (var i = 0; i < names.length; i++) {
    if (String(names[i][0]).trim() !== name) continue;
    var cell = sheet.getRange(i + 2, OBJ_COL.WIFI);
    var list = splitIps_(cell.getValue());
    if (mode === 'clear') list = [];
    else if (mode === 'remove') list = list.filter(function (x) { return x !== addr; });
    else if (list.indexOf(addr) < 0) list.push(addr);
    cell.setNumberFormat('@').setValue(list.join(', '));
    return { status: 'ok', wifiIps: list };
  }
  return { status: 'error', message: 'Объект с таким названием не найден' };
}

// ===================== PUSH-УВЕДОМЛЕНИЯ (v73) =====================
// Android-приложение присылает свой FCM-токен (registerPush), токены лежат в
// листе «Push-токены». Отправка — Firebase Cloud Messaging HTTP v1 от имени
// владельца скрипта (нужна область firebase.messaging — её добавляет и
// подтверждает setupPush). Любая ошибка отправки только записывается в
// свойство PUSH_LAST_ERROR и никогда не ломает основное действие.
var PUSH_SHEET_NAME = 'Push-токены';
var PUSH_HEADERS = ['Телефон', 'ФИО', 'Токен', 'Платформа', 'Обновлено'];
var PUSH_SCOPE = 'https://www.googleapis.com/auth/firebase.messaging';
var PUSH_REMIND_KEY = 'pushReminded_v1';

function pushSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(PUSH_SHEET_NAME);
  if (!sh) {
    sh = ss.insertSheet(PUSH_SHEET_NAME);
    sh.getRange(1, 1, 1, PUSH_HEADERS.length).setValues([PUSH_HEADERS]).setFontWeight('bold');
    sh.setFrozenRows(1);
    sh.getRange('A:A').setNumberFormat('@');
  }
  return sh;
}

function pushRows_() {
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(PUSH_SHEET_NAME);
  if (!sh || sh.getLastRow() < 2) return [];
  return sh.getRange(2, 1, sh.getLastRow() - 1, 4).getValues().map(function (r, i) {
    return { row: i + 2, phone: normalizePhone_(r[0]), token: String(r[2] || ''), platform: String(r[3] || '') };
  });
}

function deletePushRows_(rows) {
  if (!rows.length) return;
  var sh = pushSheet_();
  rows.sort(function (a, b) { return b - a; }).forEach(function (r) { sh.deleteRow(r); });
}

function registerPush(phone, token, platform, oldToken) {
  var p = normalizePhone_(phone);
  var emp = p && findEmployeeByPhone(p);
  if (!emp) return { status: 'error', message: 'Сотрудник не найден' };
  token = String(token || '').trim();
  if (token.length < 20 || token.length > 4096) return { status: 'error', message: 'Неверный токен' };
  var lock = LockService.getScriptLock();
  lock.waitLock(15000);
  try {
    var sh = pushSheet_(), rows = pushRows_(), found = 0, drop = [];
    rows.forEach(function (r) {
      if (r.token === token) {
        if (found) { drop.push(r.row); return; }
        found = r.row;
      } else if (oldToken && r.token === String(oldToken)) drop.push(r.row);
    });
    var vals = [[String(p), emp.name, token, String(platform || 'android').slice(0, 40), new Date()]];
    if (found) sh.getRange(found, 1, 1, 5).setValues(vals);
    else { sh.appendRow(vals[0]); sh.getRange(sh.getLastRow(), 1).setNumberFormat('@').setValue(String(p)); }
    deletePushRows_(drop);
  } finally {
    lock.releaseLock();
  }
  return { status: 'ok' };
}

// Выход из аккаунта на телефоне — уведомления на него больше не идут.
function unregisterPush(phone, token) {
  token = String(token || '');
  if (!token) return { status: 'ok' };
  var lock = LockService.getScriptLock();
  lock.waitLock(15000);
  try {
    deletePushRows_(pushRows_().filter(function (r) { return r.token === token; }).map(function (r) { return r.row; }));
  } finally {
    lock.releaseLock();
  }
  return { status: 'ok' };
}

function adminPhones_() {
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Сотрудники');
  if (!sh || sh.getLastRow() < 2) return [];
  return sh.getRange(2, 2, sh.getLastRow() - 1, 6).getValues().filter(function (r) {
    return r[5] === true || String(r[5]).trim().toUpperCase() === 'TRUE';
  }).map(function (r) { return normalizePhone_(r[0]); }).filter(String);
}

function fcmProjectId_() {
  return PropertiesService.getScriptProperties().getProperty('FCM_PROJECT_ID') || 'sevmod';
}

function fcmMessage_(token, title, body, data, validateOnly, dataOnly) {
  var d = {};
  Object.keys(data || {}).forEach(function (k) { if (data[k] !== undefined && data[k] !== null) d[k] = String(data[k]); });
  if (dataOnly) {
    // Приложение само рисует уведомление (с кнопками) — всё в data.
    d.title = String(title || '').slice(0, 120);
    d.body = String(body || '').slice(0, 600);
    return {
      url: 'https://fcm.googleapis.com/v1/projects/' + fcmProjectId_() + '/messages:send',
      method: 'post', contentType: 'application/json', muteHttpExceptions: true,
      headers: { Authorization: 'Bearer ' + ScriptApp.getOAuthToken() },
      payload: JSON.stringify({ message: { token: token, data: d, android: { priority: 'HIGH' } } })
    };
  }
  var msg = {
    token: token,
    notification: { title: String(title || '').slice(0, 120), body: String(body || '').slice(0, 400) },
    data: d,
    android: {
      priority: 'HIGH',
      notification: { channel_id: 'sevmod', icon: 'ic_stat_sevmod', color: '#070453', default_sound: true }
    }
  };
  if (d.tag) msg.android.notification.tag = d.tag;
  return {
    url: 'https://fcm.googleapis.com/v1/projects/' + fcmProjectId_() + '/messages:send',
    method: 'post', contentType: 'application/json', muteHttpExceptions: true,
    headers: { Authorization: 'Bearer ' + ScriptApp.getOAuthToken() },
    payload: JSON.stringify(validateOnly ? { validate_only: true, message: msg } : { message: msg })
  };
}

// Отправляет уведомление на все телефоны сотрудников из phones.
// data.screen — какой экран открыть по нажатию.
// opts.actions — телефонам с новой сборкой (platform содержит "+actions")
// уходит сообщение, которое приложение показывает с кнопками;
// opts.actionsOnly — только таким телефонам (служебные, например «убрать
// уведомление»).
function sendPush_(phones, title, body, data, opts) {
  var res = { sent: 0, failed: 0, tokens: 0, error: '' };
  opts = opts || {};
  try {
    var want = {};
    (phones || []).forEach(function (p) { p = normalizePhone_(p); if (p) want[p] = 1; });
    var targets = pushRows_().filter(function (r) {
      return want[r.phone] && r.token && (!opts.actionsOnly || r.platform.indexOf('+actions') >= 0);
    });
    res.tokens = targets.length;
    if (!targets.length) return res;
    var answers = UrlFetchApp.fetchAll(targets.map(function (t) {
      var rich = (opts.actions || opts.actionsOnly) && t.platform.indexOf('+actions') >= 0;
      return fcmMessage_(t.token, title, body, data, false, rich);
    }));
    var dead = [];
    answers.forEach(function (a, i) {
      var code = a.getResponseCode(), txt = a.getContentText();
      if (code === 200) { res.sent++; return; }
      res.failed++;
      if (code === 404 || /UNREGISTERED|registration token is not a valid/i.test(txt)) dead.push(targets[i].row);
      else res.error = 'FCM ' + code + ': ' + txt.slice(0, 300);
    });
    if (dead.length) {
      var lock = LockService.getScriptLock();
      if (lock.tryLock(10000)) {
        try {
          // строки могли сдвинуться — удаляем по токенам, а не по старым номерам строк
          var deadTok = {};
          dead.forEach(function (row) { targets.forEach(function (t) { if (t.row === row) deadTok[t.token] = 1; }); });
          deletePushRows_(pushRows_().filter(function (r) { return deadTok[r.token]; }).map(function (r) { return r.row; }));
        } finally { lock.releaseLock(); }
      }
    }
  } catch (e) {
    res.error = String(e && e.message || e);
  }
  if (res.error) {
    try { PropertiesService.getScriptProperties().setProperty('PUSH_LAST_ERROR', new Date().toISOString() + ' ' + res.error); } catch (e2) {}
  }
  return res;
}

function firstName_(fullName) {
  var parts = String(fullName || '').trim().split(/\s+/);
  return parts.length >= 2 ? parts[1] : parts[0];
}

// «Отгул 06.11–08.11», «Прийти позже — 06.11, к 12:00» + комментарий.
function absRequestText_(kind, from, to, tFrom, tTo, comment) {
  var f = function (d) { return Utilities.formatDate(new Date(d), 'Europe/Moscow', 'dd.MM'); };
  var period = f(from) + (to && f(to) !== f(from) ? '–' + f(to) : '');
  var t;
  if (kind === 'late') t = 'Прийти позже — ' + f(from) + ', к ' + tTo;
  else if (kind === 'early') t = 'Уйти пораньше — ' + f(from) + ', в ' + tFrom;
  else if (kind === 'sick') t = 'Больничный ' + period;
  else t = 'Отгул ' + period;
  comment = String(comment || '').trim();
  if (comment) t += '\nКомментарий: ' + comment.slice(0, 300);
  return t;
}

function absPeriodText_(from, to, tFrom, tTo) {
  var f = function (d) { return d ? Utilities.formatDate(new Date(d), 'Europe/Moscow', 'dd.MM') : ''; };
  var s = f(from);
  if (to && f(to) !== s) s += '–' + f(to);
  if (tFrom && tTo) s += ' ' + tFrom + '–' + tTo;
  return s;
}

// Каждые 15 минут (pushTick): напоминание тем, у кого смена закончилась
// 15+ минут назад, а уход не отмечен. Не больше одного раза за смену.
function remindOpenShifts_() {
  var map = getOpenShiftsMap_(), keys = Object.keys(map);
  if (!keys.length) return 0;
  var props = PropertiesService.getScriptProperties(), done = {};
  try { done = JSON.parse(props.getProperty(PUSH_REMIND_KEY) || '{}') || {}; } catch (e) { done = {}; }
  var now = new Date(), sent = 0, changed = false;
  keys.forEach(function (p) {
    var e = map[p];
    var since = e.since || openShiftSinceFromLog_(p);
    if (!since) return;
    var key = String(since);
    if (done[p] === key) return;
    var end = expectedShiftEnd_(e.objectName, since);
    var late = now.getTime() - end.getTime();
    if (late < 15 * 60000 || late > 2 * 3600000) return;
    sendPush_([p], 'Вы не отметили уход',
      'Смена на объекте «' + e.objectName + '» закончилась в ' + clockStr_(end) + '. Если вы уже ушли — отсканируйте QR-код или откройте приложение.',
      { screen: 'scan', tag: 'shift' });
    done[p] = key; changed = true; sent++;
  });
  Object.keys(done).forEach(function (p) { if (!map[p]) { delete done[p]; changed = true; } });
  if (changed) props.setProperty(PUSH_REMIND_KEY, JSON.stringify(done));
  return sent;
}

function pushTick() {
  try { wifiCloseDay_(); } catch (e) { /* уход по Wi-Fi — каждые 15 минут */ }
  try { remindOpenShifts_(); } catch (e) {
    try { PropertiesService.getScriptProperties().setProperty('PUSH_LAST_ERROR', new Date().toISOString() + ' remind: ' + (e && e.message || e)); } catch (e2) {}
  }
}

// Кнопка в панели администратора: тестовое уведомление себе.
function adminTestPush(adminPhone) {
  var auth = adminAuth_(adminPhone);
  if (!auth.ok) return { status: 'error', message: auth.error };
  var r = sendPush_([auth.phone], 'Проверка уведомлений SEVMOD', 'Уведомления работают.', { screen: 'admin' });
  var props = PropertiesService.getScriptProperties();
  var all = pushRows_(), people = {};
  all.forEach(function (x) { people[x.phone] = 1; });
  return { status: 'ok', sent: r.sent, failed: r.failed, tokens: r.tokens, error: r.error,
    lastError: props.getProperty('PUSH_LAST_ERROR') || '', ready: props.getProperty('PUSH_SCOPE_OK') === '1',
    devices: all.length, people: Object.keys(people).length };
}

// РАЗОВАЯ НАСТРОЙКА (запустить в редакторе дважды):
// 1-й запуск добавляет в appsscript.json право на отправку уведомлений;
// после него обновите страницу редактора (F5) и запустите setupPush ещё раз —
// Google попросит разрешение, затем функция проверит связь с Firebase,
// включит напоминания (каждые 15 минут) и обновит развертывание.
function setupPush() {
  var props = PropertiesService.getScriptProperties();
  var sid = ScriptApp.getScriptId(), base = 'https://script.googleapis.com/v1/projects/' + sid;
  var content = scriptApi_('get', base + '/content');
  var files = (content.files || []).map(function (f) { return { name: f.name, type: f.type, source: f.source }; });
  var man = files.filter(function (f) { return f.name === 'appsscript'; })[0];
  if (!man) throw new Error('Не нашёл appsscript.json');
  var j = JSON.parse(man.source);
  if (!j.oauthScopes || !j.oauthScopes.length) throw new Error('В appsscript.json нет списка oauthScopes');
  var msg;
  if (j.oauthScopes.indexOf(PUSH_SCOPE) < 0) {
    j.oauthScopes.push(PUSH_SCOPE);
    man.source = JSON.stringify(j, null, 2);
    props.deleteProperty('PUSH_SCOPE_OK');
    scriptApi_('put', base + '/content', { files: files });
    msg = 'Шаг 1 из 2 готов. Обновите страницу редактора (F5), выберите setupPush и снова нажмите «Выполнить» — Google попросит разрешение «отправлять сообщения Firebase Cloud Messaging».';
    selfUpdateLog_('setupPush', '', '', '', 'шаг 1', msg);
    Logger.log(msg);
    return msg;
  }
  // Проверка: пробная отправка (validate_only) на заведомо неверный токен.
  // 400 «not a valid FCM registration token» = права и проект в порядке.
  var a = UrlFetchApp.fetchAll([fcmMessage_('test-token-0000000000000000000000', 't', 'b', {}, true)])[0];
  var code = a.getResponseCode(), txt = a.getContentText();
  var fcmOk = code === 200 || (code === 400 && /INVALID_ARGUMENT|registration token/i.test(txt));
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === 'pushTick') ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger('pushTick').timeBased().everyMinutes(15).create();
  props.setProperty('PUSH_SCOPE_OK', '1');
  var ver = scriptApi_('post', base + '/versions', { description: CODE_VERSION + ' (setupPush)' });
  scriptApi_('put', base + '/deployments/' + selfUpdateDeploymentId_(), {
    deploymentConfig: { scriptId: sid, versionNumber: ver.versionNumber, manifestFileName: 'appsscript', description: CODE_VERSION + ' (setupPush)' }
  });
  pushSheet_();
  if (fcmOk) {
    msg = 'Готово: уведомления включены (проект Firebase ' + fcmProjectId_() + '), напоминания каждые 15 минут, развертывание обновлено (версия №' + ver.versionNumber + ').';
  } else {
    msg = 'Права выданы и развертывание обновлено, но Firebase ответил ошибкой ' + code + ': ' + txt.slice(0, 400) +
      (code === 403 ? ' — включите «Firebase Cloud Messaging API» в Google Cloud для проекта ' + fcmProjectId_() + '.' : '') +
      (code === 404 ? ' — проверьте свойство скрипта FCM_PROJECT_ID (ID проекта Firebase).' : '');
  }
  selfUpdateLog_('setupPush', '', CODE_VERSION, '', fcmOk ? 'настроено' : 'ошибка', msg);
  Logger.log(msg);
  return msg;
}

// ===================== ОБЩИЙ КАБИНЕТ (v84) =====================
// Для администратора: как сотрудники посещают объекты. mode 'day' — за
// дату (кто пришёл/ушёл, где, опоздания, кто сейчас на смене, кто в
// отгуле, кто не отмечался); 'month' — итоги за месяц по каждому.
// mode 'range' — период dateIso..dateTo (итоги, как за месяц).
function adminAttendance(adminPhone, dateIso, mode, dateTo, internal) {
  if (internal !== true) {
    var auth = adminAuth_(adminPhone);
    if (!auth.ok) return { status: 'error', message: auth.error };
  }
  mode = mode === 'month' || mode === 'range' ? mode : 'day';
  var tz = 'Europe/Moscow';
  var day = parseIsoDate_(dateIso) || startOfDay_(new Date());
  var todayIso = Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd');
  var dayIso = Utilities.formatDate(day, tz, 'yyyy-MM-dd');
  var monthKey = dayIso.slice(0, 7);
  var fromIso = dayIso, toIso = dayIso;
  if (mode === 'month') {
    fromIso = monthKey + '-01';
    var lastDay = new Date(day.getFullYear(), day.getMonth() + 1, 0);
    toIso = Utilities.formatDate(lastDay, tz, 'yyyy-MM-dd');
  } else if (mode === 'range') {
    var t2 = parseIsoDate_(dateTo) || day;
    toIso = Utilities.formatDate(t2, tz, 'yyyy-MM-dd');
    if (toIso < fromIso) { var sw = toIso; toIso = fromIso; fromIso = sw; }
  }
  if (mode !== 'day' && fromIso === toIso && mode === 'range') mode = 'day';
  var ss = SpreadsheetApp.getActiveSpreadsheet();

  // сотрудники
  var people = [], byPhone = {}, byName = {};
  var es = ss.getSheetByName('Сотрудники');
  if (es && es.getLastRow() >= 2) {
    es.getRange(2, 1, es.getLastRow() - 1, 2).getValues().forEach(function (r) {
      var name = String(r[0] || '').trim(), p = normalizePhone_(r[1]);
      if (!name || !p || byPhone[p]) return;
      var o = { name: name, phone: p, days: {} };
      people.push(o); byPhone[p] = o; byName[name] = o;
    });
  }

  // отметки
  var log = ss.getSheetByName('Учет');
  if (log && log.getLastRow() >= 2) {
    var lc = Math.max(9, Math.min(log.getLastColumn(), 12));
    log.getRange(2, 1, log.getLastRow() - 1, lc).getValues().forEach(function (r) {
      var ts = r[0];
      if (!(ts instanceof Date)) return;
      var iso = Utilities.formatDate(ts, tz, 'yyyy-MM-dd');
      if (mode === 'day' ? iso !== dayIso : (iso < fromIso || iso > toIso)) return;
      var o = byPhone[normalizePhone_(r[2])] || byName[String(r[1] || '').trim()];
      if (!o) return;
      var obj = String(r[3] || '').trim(), type = r[4];
      if (type !== 'Приход' && type !== 'Уход') return;
      (o.ev = o.ev || []).push({ ts: ts, type: type, obj: obj, note: r[8], late: type === 'Приход' ? computeLate_(ts, obj, r[2]) : null });
    });
  }
  // смены (пары «приход → уход») раскладываем по дням прихода
  people.forEach(function (o) {
    if (!o.ev) return;
    segmentsFromEvents_(o.ev).forEach(function (sg) {
      var iso = Utilities.formatDate(sg.arrival || sg.departure, tz, 'yyyy-MM-dd');
      var d = o.days[iso] || (o.days[iso] = { arrival: null, departure: null, object: '', late: null, note: '', objects: {}, segs: [], frac: 0 });
      d.segs.push(sg);
      if (sg.object) d.objects[sg.object] = true;
      if (sg.arrival && (!d.arrival || sg.arrival < d.arrival)) { d.arrival = sg.arrival; d.object = sg.object || d.object; d.late = sg.late; }
      if (sg.departure && (!d.departure || sg.departure > d.departure)) { d.departure = sg.departure; d.note = sg.note; }
      if (!d.object && sg.object) d.object = sg.object;
      if (sg.arrival && sg.departure && sg.departure > sg.arrival) d.frac += (sg.departure - sg.arrival) / 86400000;
    });
  });

  // согласованные отсутствия
  var absMap = {};
  var as = ss.getSheetByName(ABSENCE_SHEET_NAME);
  if (as && as.getLastRow() >= 2) {
    as.getRange(2, 1, as.getLastRow() - 1, ABS_COL.STATUS).getValues().forEach(function (r) {
      if (absStatusOf_(r[ABS_COL.STATUS - 1]) !== ABS_STATUS.APPROVED) return;
      var f = r[ABS_COL.FROM - 1], t = r[ABS_COL.TO - 1];
      if (!(f instanceof Date)) return;
      if (!(t instanceof Date)) t = f;
      var p = normalizePhone_(r[ABS_COL.PHONE - 1]);
      var fi = Utilities.formatDate(f, tz, 'yyyy-MM-dd'), ti = Utilities.formatDate(t, tz, 'yyyy-MM-dd');
      (absMap[p] = absMap[p] || []).push({ from: fi, to: ti, type: String(r[ABS_COL.TYPE - 1] || ''),
        tFrom: String(r[ABS_COL.TIME_FROM - 1] || ''), tTo: String(r[ABS_COL.TIME_TO - 1] || '') });
    });
  }
  function hm(d) { return d ? Utilities.formatDate(d, tz, 'HH:mm') : ''; }
  var open = getOpenShiftsMap_();

  if (mode === 'day') {
    var items = people.map(function (o) {
      var d = o.days[dayIso], it = { name: o.name, phone: o.phone };
      if (d) {
        it.arrival = hm(d.arrival); it.departure = hm(d.departure); it.object = d.object;
        it.objects = Object.keys(d.objects); it.late = d.late; it.closeNote = d.note;
        if (d.frac) it.hours = hoursFractionToStr(d.frac);
        it.segments = d.segs.map(function (sg) {
          return { object: sg.object, arrival: hm(sg.arrival), departure: hm(sg.departure), late: sg.late,
            hours: sg.arrival && sg.departure && sg.departure > sg.arrival ? hoursFractionToStr((sg.departure - sg.arrival) / 86400000) : '', closeNote: sg.note };
        });
      }
      var os = open[o.phone];
      if (dayIso === todayIso && os) {
        // начало — по журналу (время прихода могли поправить в таблице)
        var since = openShiftSinceFromLog_(o.phone) || os.since;
        it.onShift = { object: os.objectName, since: since ? hm(new Date(since)) : '' };
      }
      (absMap[o.phone] || []).forEach(function (a) { if (a.from <= dayIso && dayIso <= a.to) it.absence = a; });
      return it;
    });
    // порядок: на смене, были, отсутствие, не отмечались
    var rank = function (it) { return it.onShift ? 0 : (it.arrival || it.departure ? 1 : (it.absence ? 2 : 3)); };
    items.sort(function (a, b) { return rank(a) - rank(b) || (a.arrival || '99').localeCompare(b.arrival || '99') || a.name.localeCompare(b.name); });
    return { status: 'ok', mode: 'day', date: dayIso, today: todayIso, items: items };
  }

  var rows = people.map(function (o) {
    var keys = Object.keys(o.days), frac = 0, late = 0, lateMin = 0, auto = 0, objs = {}, worked = 0, byObj = {};
    keys.forEach(function (k) {
      var d = o.days[k];
      if (d.arrival) worked++;
      var f = d.frac || 0;
      frac += f;
      // по объектам: смена засчитывается объекту прихода (иначе — любому из дня)
      // по объектам: каждая смена — своему объекту
      var seenObj = {};
      d.segs.forEach(function (sg) {
        var ob = sg.object || d.object; if (!ob) return;
        var bo = byObj[ob] || (byObj[ob] = { days: 0, frac: 0, late: 0 });
        if (sg.arrival && !seenObj[ob]) { bo.days++; seenObj[ob] = 1; }
        if (sg.arrival && sg.departure && sg.departure > sg.arrival) bo.frac += (sg.departure - sg.arrival) / 86400000;
        if (sg.late > 0) bo.late++;
      });
      if (d.late > 0) { late++; lateMin += d.late; }
      if (d.note === 'auto') auto++;
      Object.keys(d.objects).forEach(function (x) { objs[x] = (objs[x] || 0) + 1; });
    });
    var absDays = 0;
    (absMap[o.phone] || []).forEach(function (a) {
      if (a.type === 'Приду позже' || a.type === 'Уйду раньше') return;
      for (var dt = parseIsoDate_(a.from), end = parseIsoDate_(a.to); dt && dt <= end; dt.setDate(dt.getDate() + 1)) {
        var di = Utilities.formatDate(dt, tz, 'yyyy-MM-dd');
        if (di >= fromIso && di <= toIso && isRuWorkday_(dt)) absDays++;
      }
    });
    // все смены за период — для просмотра одного сотрудника
    // каждая смена — отдельно (в один день может быть несколько объектов)
    var shifts = [];
    keys.sort().reverse().forEach(function (k) {
      var d = o.days[k], os = open[o.phone];
      d.segs.slice().sort(function (a, b) { return (b.arrival || b.departure) - (a.arrival || a.departure); }).forEach(function (sg) {
        var f = sg.arrival && sg.departure && sg.departure > sg.arrival ? (sg.departure - sg.arrival) / 86400000 : 0;
        var on = k === todayIso && os && !sg.departure && sg.arrival && objKey_(sg.object) === objKey_(os.objectName);
        shifts.push({ date: k, arrival: hm(sg.arrival), departure: hm(sg.departure), hours: f ? hoursFractionToStr(f) : '',
          object: sg.object || '', objects: sg.object ? [sg.object] : [], late: sg.late, closeNote: sg.note, onShift: !!on });
      });
    });
    return { name: o.name, phone: o.phone, shifts: shifts, days: worked, hours: hoursFractionToStr(frac), hoursNum: Math.round(frac * 24 * 10) / 10,
      lateDays: late, lateMinutes: lateMin, autoClosed: auto, absenceDays: absDays,
      objects: Object.keys(objs).sort(function (a, b) { return objs[b] - objs[a]; }).slice(0, 3),
      allObjects: Object.keys(objs),
      byObject: Object.keys(byObj).reduce(function (m, k) {
        m[k] = { days: byObj[k].days, hours: hoursFractionToStr(byObj[k].frac), hoursNum: Math.round(byObj[k].frac * 24 * 10) / 10, lateDays: byObj[k].late };
        return m;
      }, {}) };
  });
  rows.sort(function (a, b) { return b.hoursNum - a.hoursNum || a.name.localeCompare(b.name); });
  // рабочие дни периода (по производственному календарю, не дальше сегодня)
  var workdays = 0;
  for (var wd = parseIsoDate_(fromIso), wEnd = parseIsoDate_(toIso < todayIso ? toIso : todayIso); wd && wEnd && wd <= wEnd; wd.setDate(wd.getDate() + 1)) {
    if (isRuWorkday_(wd)) workdays++;
  }
  return { status: 'ok', mode: 'month', month: monthKey, from: fromIso, to: toIso, today: todayIso, workdays: workdays, items: rows };
}


// ===================== ОПОЗДАНИЯ (v88) =====================
// Опоздание считается от начала смены объекта (лист «Объекты», если задано),
// иначе — от начала рабочего дня OFFICE_START (10:00). Согласованное «Приду
// позже» на этот день сдвигает начало на согласованное время. Раньше при
// незаданных сменах опоздание не записывалось вовсе.
var lateCtxCache_ = null;
function lateCtx_() {
  if (lateCtxCache_) return lateCtxCache_;
  var c = { shifts: {}, until: {} };
  try { c.shifts = getObjectShifts(); } catch (e) {}
  try {
    var as = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(ABSENCE_SHEET_NAME);
    if (as && as.getLastRow() >= 2) {
      as.getRange(2, 1, as.getLastRow() - 1, ABS_COL.STATUS).getValues().forEach(function (r) {
        if (absStatusOf_(r[ABS_COL.STATUS - 1]) !== ABS_STATUS.APPROVED) return;
        if (String(r[ABS_COL.TYPE - 1]) !== ABSENCE_KINDS.late) return;
        var f = r[ABS_COL.FROM - 1], tTo = normalizeTimeStr(r[ABS_COL.TIME_TO - 1]);
        if (!(f instanceof Date) || !tTo) return;
        c.until[normalizePhone_(r[ABS_COL.PHONE - 1]) + '|' + toIsoDate_(f)] = tTo;
      });
    }
  } catch (e2) {}
  lateCtxCache_ = c;
  return c;
}
function computeLate_(ts, objectName, phone) {
  if (!(ts instanceof Date)) return null;
  var c = lateCtx_();
  var arr = ts.getHours() * 60 + ts.getMinutes();
  var allowed = c.until[normalizePhone_(phone) + '|' + toIsoDate_(ts)];
  if (allowed) return Math.max(0, arr - timeStrToMinutes(allowed));
  var n = findNearestShift(ts, c.shifts[String(objectName || '').trim()]);
  if (n) return Math.max(0, n.lateMinutes);
  return Math.max(0, arr - timeStrToMinutes(OFFICE_START));
}

// ===================== АВТООТМЕТКА ПО Wi-Fi ОФИСА (v90, тест) =====================
// Android-приложение (если включено) при каждой смене сети и раз в ~15 минут
// сообщает свой внешний IP и подключён ли телефон к Wi-Fi (wifiPresence).
// Сервер узнаёт офис по IP (колонка «Wi-Fi офиса (IP)» в «Объекты»):
//  • первое появление в сети офиса за день → приход (если сегодня прихода не было);
//  • уходы из сети днём (обед, перекур) смену не закрывают — пишутся в журнал;
//  • в 22:00 открытая смена закрывается временем последнего присутствия в сети.
// Журнал: лист «Wi-Fi присутствие». Кто включил: свойство wifiAuto_v1.
var WIFI_LOG_SHEET = 'Wi-Fi присутствие';
var WIFI_AUTO_KEY = 'wifiAuto_v1', WIFI_STATE_KEY = 'wifiPresence_v1';
var WIFI_DAY_CLOSE_HOUR = 22;
function wifiProps_(key) { try { return JSON.parse(PropertiesService.getScriptProperties().getProperty(key) || '{}') || {}; } catch (e) { return {}; } }
function wifiSave_(key, v) { PropertiesService.getScriptProperties().setProperty(key, JSON.stringify(v)); }
function wifiLog_(name, phone, event, object, ip, note, at) {
  var ss = SpreadsheetApp.getActiveSpreadsheet(), sh = ss.getSheetByName(WIFI_LOG_SHEET);
  if (!sh) {
    sh = ss.insertSheet(WIFI_LOG_SHEET);
    sh.getRange(1, 1, 1, 7).setValues([['Время', 'ФИО', 'Телефон', 'Событие', 'Объект', 'IP', 'Примечание']]).setFontWeight('bold');
    sh.setFrozenRows(1);
    sh.getRange('C:C').setNumberFormat('@');
  }
  sh.appendRow([at || new Date(), name, String(phone), event, object || '', ip || '', note || '']);
  sh.getRange(sh.getLastRow(), 1).setNumberFormat('dd.MM.yyyy HH:mm:ss');
}
// Сети офисов из колонки «Wi-Fi офиса (сеть)»: [{ssid, bssid}]
function cleanSsid_(s) { s = String(s || '').trim().replace(/^"|"$/g, ''); return s === '<unknown ssid>' ? '' : s.slice(0, 64); }
function cleanBssid_(b) { b = String(b || '').trim().toLowerCase(); return /^([0-9a-f]{2}:){5}[0-9a-f]{2}$/.test(b) && b !== '02:00:00:00:00:00' ? b : ''; }
function parseWifiNets_(v) {
  return String(v || '').split(';').map(function (x) {
    x = x.trim(); if (!x) return null;
    var m = /^(.*?)\s*\(([0-9a-fA-F:]{17})\)\s*$/.exec(x);
    return m ? { ssid: cleanSsid_(m[1]), bssid: cleanBssid_(m[2]) } : { ssid: cleanSsid_(x), bssid: '' };
