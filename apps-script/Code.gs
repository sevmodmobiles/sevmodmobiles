  if (!sh) {
    sh = ss.insertSheet(WH_LOG_SHEET);
    sh.getRange(1, 1, 1, 9).setValues([['Дата', 'Кто', 'ID', 'Наименование', 'Ед.', 'Операция', 'Изменение', 'Остаток после', 'Комментарий']]).setFontWeight('bold');
